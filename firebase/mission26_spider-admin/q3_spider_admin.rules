rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isClerk() {
      return signedIn() && request.auth.token.role in ["clerk", "manager"];
    }

    function onlyStockDown() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
          && request.resource.data.stock < resource.data.stock
          && request.resource.data.stock >= 0;
    }

    function validPrice() {
      return request.resource.data.price is number
          && request.resource.data.price > 0;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isClerk() && validPrice();
      allow update: if (isClerk() && validPrice())
                    || (signedIn() && onlyStockDown());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
