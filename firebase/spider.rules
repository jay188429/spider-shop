rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMine(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isClerk() {
      return signedIn() && request.auth.token.role in ["clerk", "manager"];
    }

    match /products/{productId} {
      allow read: if true;
      allow update: if isClerk()
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;
    }
    match /orders/{orderId} {
      allow read: if isMine(resource.data.userId) || isClerk();
      allow create: if isMine(request.resource.data.userId);
      allow update: if isClerk();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
